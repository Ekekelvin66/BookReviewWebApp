<!-- partials/navbar.ejs -->
<nav class="navbar">
  <a href="/" class="navbar-brand">My<span>Books</span></a>
  <ul class="navbar-links desktop-nav"div="navbar-links">
    <li><a href="/" class="<%= locals.activePage === 'home' ? 'active' : '' %>">Home</a></li>
    <% if (locals.user) { %>
      <li><a href="/books/add">Add Book</a></li>
      <li>
        <a href="/profile" class="nav-avatar" title="<%= user.name %>">
          <%= user.name.charAt(0).toUpperCase() %>
        </a>
      </li>
      <li>
        <form action="/logout" method="GET" style="margin:0">
          <button type="submit">Logout</button>
        </form>
      </li>
    <% } else { %>
      <li><a href="/login">Login</a></li>
    <% } %>
  </ul>
  <div class="mobile-nav ">
    <% if (locals.user) { %>
      <a href="/profile" class="nav-avatar"><%= user.name.charAt(0).toUpperCase() %></a>
      <button class="hamburger" onclick="toggleMenu()">&#9776;</button>
      <ul class="mobile-dropdown" id="mobile-dropdown">
        <li><a href="/">Home</a></li>
        <li><a href="/books/add">Add Book</a></li>
        <li>
          <form action="/logout" method="GET" style="margin:0">
            <button type="submit">Logout</button>
          </form>
        </li>
      </ul>
    <% } else { %>
      <ul class="mobile-guest-links">
        <li><a href="/">Home</a></li>
        <li><a href="/login">Login</a></li>
      </ul>
    <% } %>
  </div>
</nav>
 
<script>
  function toggleMenu() {
    document.getElementById('mobile-dropdown').classList.toggle('open')
  }
</script>