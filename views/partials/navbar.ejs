<!-- partials/navbar.ejs -->
<nav class="navbar">
  <a href="/" class="navbar-brand">My<span>Books</span></a>
  <ul class="navbar-links">
    <li><a href="/" class="<%= locals.activePage === 'home' ? 'active' : '' %>">Home</a></li>
    <% if (locals.user) { %>
      <li><a href="/books/add">Add Book</a></li>
      <li>
        <a href="/profile" class="nav-avatar" title="<%= user.name %>">
          <%= user.name.charAt(0).toUpperCase() %>
        </a>
      </li>
      <li>
        <form action="/logout" method="GET" style="margin:0">
          <button type="submit">Logout</button>
        </form>
      </li>
    <% } else { %>
      <li><a href="/login">Login</a></li>
    <% } %>
  </ul>
</nav>
