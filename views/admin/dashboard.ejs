<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/header', { pageTitle: 'Admin Dashboard — MyBooks' }) %>
<style>
  .admin-page { width:100%; margin: 2.5rem auto; padding: 0 2rem 4rem; }

  .admin-header {
    background: var(--navy);
    border-radius: var(--radius);
    padding: 2rem 2.5rem;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2rem;
    box-shadow: var(--shadow-md);
  }

  .admin-header h1 {
    font-family: 'Playfair Display', serif;
    font-size: 1.8rem;
    color: #fff;
  }

  .admin-header p { color: rgba(255,255,255,0.5); font-size: 0.85rem; margin-top: 0.25rem; }

  .admin-badge {
    background: var(--gold);
    color: var(--navy);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 0.3rem 0.85rem;
    border-radius: 99px;
  }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .stat-card {
    background: var(--card-bg);
    border-radius: var(--radius);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
    border: 1px solid rgba(27,42,74,0.07);
    text-align: center;
  }

  .stat-card .stat-number {
    font-family: 'Playfair Display', serif;
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--navy);
    line-height: 1;
  }

  .stat-card .stat-label {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text-light);
    margin-top: 0.35rem;
    font-weight: 500;
  }

  .admin-section { margin-bottom: 3rem; }

  .admin-section-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.3rem;
    color: var(--navy);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--cream-dark);
  }

  .admin-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--card-bg);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    font-size: 0.875rem;
  }

  .admin-table thead {
    background: var(--navy);
    color: #fff;
  }

  .admin-table th {
    padding: 0.85rem 1rem;
    text-align: left;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    font-weight: 600;
  }

  .admin-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--cream-dark);
    color: var(--text-mid);
    vertical-align: middle;
  }

  .admin-table tr:last-child td { border-bottom: none; }
  .admin-table tr:hover td { background: rgba(27,42,74,0.02); }

  .admin-table .book-thumb {
    width: 32px;
    height: 44px;
    object-fit: cover;
    border-radius: 3px;
    box-shadow: var(--shadow-sm);
  }

  .admin-table .book-cell {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .admin-table .book-cell-info strong {
    display: block;
    font-weight: 600;
    color: var(--navy);
    font-size: 0.875rem;
  }

  .admin-table .book-cell-info span {
    font-size: 0.78rem;
    color: var(--text-light);
  }

  .table-actions { display: flex; gap: 0.4rem; flex-wrap: wrap; }

  .status-badge {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 99px;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.3px;
  }

  .status-active { background: rgba(39,174,96,0.12); color: #1e8449; }
  .status-banned { background: rgba(192,57,43,0.1); color: #c0392b; }
  .status-admin  { background: rgba(201,168,76,0.15); color: #8a6d1e; }

  .tabs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .tab-btn {
    padding: 0.5rem 1.25rem;
    border-radius: 6px;
    border: 1.5px solid var(--cream-dark);
    background: #fff;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    color: var(--text-mid);
    transition: all var(--transition);
  }

  .tab-btn.active, .tab-btn:hover {
    background: var(--navy);
    border-color: var(--navy);
    color: #fff;
  }

  .tab-panel { display: none; }
  .tab-panel.active { display: block; }

  @media (max-width: 768px) {
    .stats-row { grid-template-columns: repeat(2, 1fr); }
    .admin-table { font-size: 0.78rem; }
    .admin-table th, .admin-table td { padding: 0.6rem 0.75rem; }
  }
</style>
</head>
<body>

<%- include('../partials/navbar', {}) %>

<div class="admin-page">

  <!-- Header -->
  <div class="admin-header">
    <div>
      <h1>Admin Dashboard</h1>
      <p>Manage books, users and content</p>
    </div>
    <span class="admin-badge">&#9679; Admin</span>
  </div>

  <!-- Stats -->
  <div class="stats-row">
    <div class="stat-card">
      <div class="stat-number"><%= books.length %></div>
      <div class="stat-label">Total Books</div>
    </div>
    <div class="stat-card">
      <div class="stat-number"><%= users.length %></div>
      <div class="stat-label">Total Users</div>
    </div>
    <div class="stat-card">
      <div class="stat-number"><%= totalReviews %></div>
      <div class="stat-label">Total Reviews</div>
    </div>
  </div>

  <!-- Tabs -->
  <div class="tabs">
    <button class="tab-btn active" onclick="switchTab('books', this)">Books (<%= books.length %>)</button>
    <button class="tab-btn" onclick="switchTab('users', this)">Users (<%= users.length %>)</button>
  </div>

  <!-- Books Tab -->
  <div class="tab-panel active" id="tab-books">
    <div class="admin-section">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Book</th>
            <th>Reviews</th>
            <th>Avg Rating</th>
            <th>Added</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% books.forEach(book => { %>
            <tr>
              <td>
                <div class="book-cell">
                  <img class="book-thumb" src="<%= book.cover_url || '/images/placeholder.jpg' %>" alt="<%= book.title %>" onerror="this.src='/images/placeholder.jpg'" />
                  <div class="book-cell-info">
                    <strong><%= book.title %></strong>
                    <span><%= book.author %></span>
                  </div>
                </div>
              </td>
              <td><%= book.review_count %></td>
              <td><%= book.avg_rating || '—' %></td>
              <td><%= new Date(book.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></td>
              <td>
                <div class="table-actions">
                  <a href="/admin/books/<%= book.id %>/edit" class="btn btn-outline btn-sm">&#9998; Edit</a>
                  <form action="/admin/books/<%= book.id %>/delete" method="POST" onsubmit="return confirm('Delete <%= book.title %>? This will also delete all its reviews.')">
                    <button type="submit" class="btn btn-danger btn-sm">&#128465; Delete</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Users Tab -->
  <div class="tab-panel" id="tab-users">
    <div class="admin-section">
      <table class="admin-table">
        <thead>
          <tr>
            <th>User</th>
            <th>Email</th>
            <th>Reviews</th>
            <th>Status</th>
            <th>Joined</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(u => { %>
            <tr>
              <td>
                <strong style="color: var(--navy)"><%= u.name %></strong>
              </td>
              <td><%= u.email %></td>
              <td><%= u.review_count %></td>
              <td>
                <% if (u.is_admin) { %>
                  <span class="status-badge status-admin">Admin</span>
                <!-- <% } else if (u.is_banned) { %>
                  <span class="status-badge status-banned">Banned</span> -->
                <% } else { %>
                  <span class="status-badge status-active">Active</span>
                <% } %>
              </td>
              <td><%= new Date(u.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></td>
              <td>
                <% if (!u.is_admin) { %>
                  <div class="table-actions">
                    <!-- <form action="/admin/users/<%= u.id %>/ban" method="POST">
                      <button type="submit" class="btn btn-outline btn-sm">
                        <%= u.is_banned ? '&#128275; Unban' : '&#128274; Ban' %>
                      </button>
                    </form> -->
                    <form action="/admin/users/<%= u.id %>/delete" method="POST" onsubmit="return confirm('Delete <%= u.name %>? This cannot be undone.')">
                      <button type="submit" class="btn btn-danger btn-sm">&#128465; Delete</button>
                    </form>
                  </div>
                <% } else { %>
                  <span style="font-size:0.78rem; color: var(--text-light)">Protected</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<%- include('../partials/footer') %>

<script>
  function switchTab(name, btn) {
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'))
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'))
    document.getElementById('tab-' + name).classList.add('active')
    btn.classList.add('active')
  }
</script>

</body>
</html>
