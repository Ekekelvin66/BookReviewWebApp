<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/header', { pageTitle: 'Edit Book — Admin' }) %></head>
<body>

<%- include('../partials/navbar', {}) %>

<div class="form-page">

  <a href="/admin" class="back-link">&#8592; Back to Dashboard</a>

  <div class="form-page-header">
    <h1>Edit Book</h1>
    <p>Update book details and genres.</p>
  </div>

  <% if (locals.error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <div class="form-card">
    <form action="/admin/books/<%= book.id %>/edit" method="POST">

      <div class="form-group">
        <label for="title">Title</label>
        <input type="text" name="title" id="title" class="form-control" value="<%= book.title %>" required />
      </div>

      <div class="form-group">
        <label for="author">Author</label>
        <input type="text" name="author" id="author" class="form-control" value="<%= book.author %>" required />
      </div>

      <div class="form-group">
        <label for="cover_url">Cover URL</label>
        <input type="text" name="cover_url" id="cover_url" class="form-control" value="<%= book.cover_url || '' %>" placeholder="https://..." />
      </div>

      <div class="form-group">
        <label>Genres</label>
        <div class="genre-checkbox-group">
          <% genres.forEach(genre => { %>
            <label class="genre-checkbox-label">
              <input
                type="checkbox"
                name="genres"
                value="<%= genre.id %>"
                <%= book.genre_ids && book.genre_ids.includes(genre.id) ? 'checked' : '' %>
              />
              <%= genre.name %>
            </label>
          <% }) %>
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-gold btn-lg">Save Changes</button>
        <a href="/admin" class="btn btn-outline btn-lg">Cancel</a>
      </div>

    </form>
  </div>
</div>

<%- include('../partials/footer') %>

</body>
</html>
