<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/header', { pageTitle: 'Login — MyBooks' }) %></head>
<body>

<div class="auth-page">
  <div class="auth-card">
    <h1>Welcome back</h1>
    <p>Log in to your reading library.</p>

    <% if (locals.error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>
     <div class="auth-tabs">
      <button class="auth-tab active" onclick="switchTab('google')">Google</button>
      <button class="auth-tab" onclick="switchTab('manual')">Email</button>
    </div>

    <!-- Google Panel -->
    <div class="auth-panel" id="panel-google">
      <p class="panel-desc">Sign in quickly and securely with your Google account.</p>
      <a href="/auth/google" class="btn btn-google">
        <svg width="18" height="18" viewBox="0 0 48 48">
          <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
          <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
          <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
          <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
        </svg>
        Continue with Google
      </a>
    </div>

    <!-- Manual Panel -->
    <div class="auth-panel hidden" id="panel-manual">
      <form action="/login<%= redirect ? '?redirect=' + redirect : '' %>" method="POST">
        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" name="email" id="email" class="form-control" placeholder="you@example.com" required />
        </div>
        <div class="form-group">
          <label for="password">Password</label>
          <input type="password" name="password" id="password" class="form-control" placeholder="••••••••" required />
        </div>
        <button type="submit" class="btn btn-gold btn-lg" style="width:100%">Login</button>
      </form>

      <% if (error && error.length > 0) { %>
        <div class="auth-footer">
          <a href="/forgot-password">Forgot Password?</a>
        </div>
      <% } %>

      <!-- <div class="manual-note">
        ℹ️ Manual login is only for non-Google users. If you signed up with Google, use the Google tab.
      </div> -->
      <div class="auth-footer">
      Don't have an account? <a href="/register">Register</a>
    </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
  <script>
     function switchTab(tab) {
    document.querySelectorAll('.auth-tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.auth-panel').forEach(p => p.classList.add('hidden'));
    document.getElementById('panel-' + tab).classList.remove('hidden');
    event.target.classList.add('active');
  }
  </script>
</body>
</html>
