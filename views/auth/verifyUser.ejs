<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/header', { pageTitle: 'Verify Email — MyBooks' }) %></head>
<body>

<div class="auth-page">
  <div class="auth-card">

    <% if (locals.error) { %>
      <h1>Verification Failed</h1>
      <p>We couldn't verify your email address.</p>
      <div class="alert alert-error"><%= error %></div>
      
      <div class="resend-container" style="margin-top: 1.5rem; text-align: left;">
        <p style="font-size: 0.9rem; margin-bottom: 0.5rem;">Enter your email to get a new link:</p>
        <form action="/resend-verification" method="POST">
          <input type="email" name="email" value="<%= locals.email ? email : '' %>" placeholder="your@email.com" required 
                 style="width: 100%; padding: 0.75rem; border: 1px solid #ddd; border-radius: 4px; margin-bottom: 1rem;">
          <button type="submit" class="btn btn-gold" style="width: 100%;">Resend Verification Link</button>
        </form>
      </div>

      <div class="auth-footer">
        <a href="/login">Back to Login</a>
      </div>

    <% } else if (locals.message) { %>
      <h1>Link Sent!</h1>
      <p><%= message %></p>
      <div class="alert" style="background:rgba(22,163,74,0.08); border:1px solid rgba(22,163,74,0.2); color:#15803d;">
        ✓ Please check your inbox and spam folder.
      </div>
      <div class="auth-footer">
        <a href="/login">Back to Login</a>
      </div>

    <% } else { %>
      <h1>Email Verified!</h1>
      <p>Your account has been successfully verified.</p>
      <div class="alert" style="background:rgba(22,163,74,0.08); border:1px solid rgba(22,163,74,0.2); color:#15803d;">
        ✓ You can now log in to your account.
      </div>
      <a href="/login" class="btn btn-gold btn-lg" style="width:100%; display:flex; justify-content:center;">Go to Login</a>
      <div class="auth-footer">
        <a href="/">Back to Home</a>
      </div>
    <% } %>

  </div>
</div>

<%- include('../partials/footer') %>

</body>
</html>